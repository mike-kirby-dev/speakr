# ---------------------------------------------------------------------------
# Speakr — Google Drive → R2 ingestion (storage on R2 + inbox watcher)
# ---------------------------------------------------------------------------
# Copy the relevant lines into your Speakr .env. This profile points Speakr's
# storage at a Cloudflare R2 bucket AND turns on the S3/R2 ingestion watcher so
# files an external rclone job drops into inbox/ get transcribed automatically.
#
# See docs/admin-guide/google-drive-r2-ingestion.md for the full setup
# (rclone remotes, the scheduled rclone move, and the data flow).
# ---------------------------------------------------------------------------

# --- Storage: point Speakr at R2 (S3-compatible, presigned URLs work) -------
FILE_STORAGE_BACKEND=s3
S3_BUCKET_NAME=speakr-recordings
S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=__set_me__
S3_SECRET_ACCESS_KEY=__set_me__
S3_REGION=auto                 # R2 ignores the region but boto3 wants a value
S3_USE_PATH_STYLE=true         # required for R2
FILE_STORAGE_KEY_PREFIX=recordings   # final media lands under recordings/
S3_PRESIGN_TTL_SECONDS=900     # UI playback signed-URL TTL

# --- Ingestion: watch the inbox/ prefix for new objects ---------------------
ENABLE_S3_INGEST=true
S3_INGEST_PREFIX=inbox/                  # watcher polls this prefix
S3_INGEST_PROCESSING_PREFIX=processing/  # claimed objects parked here mid-ingest
S3_INGEST_FAILED_PREFIX=failed/          # objects that failed the pipeline
S3_INGEST_CHECK_INTERVAL=60              # seconds between R2 list calls (30–120 ok)
S3_INGEST_MODE=admin_only                # admin_only | user_directories | single_user
# S3_INGEST_DEFAULT_USERNAME=mike@example.com   # required only for single_user mode
